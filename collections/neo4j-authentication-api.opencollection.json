{
  "opencollection": "1.0.0",
  "info": {
    "name": "Neo4j Aura Authentication API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Obtain an OAuth2 access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.neo4j.io/v1/oauth/token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "grant_type",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Authenticates using client credentials to obtain a bearer token for API access. The client ID and client secret are provided using HTTP Basic Authentication. Access tokens expire after one hour and a new token must be obtained when the current one expires. A 403 Forbidden response indicates an expired token."
        }
      ]
    }
  ],
  "bundled": true
}