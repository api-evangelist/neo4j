{
  "opencollection": "1.0.0",
  "info": {
    "name": "Neo4j Aura Authentication Discovery API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Discovery",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Discovery endpoint",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.neo4j.io/v1/"
          },
          "docs": "Returns a list of available endpoints on the Neo4j installation, together with basic server information including the Neo4j version, edition, Bolt connection URIs, and authentication configuration. This endpoint does not require authentication."
        }
      ]
    }
  ],
  "bundled": true
}